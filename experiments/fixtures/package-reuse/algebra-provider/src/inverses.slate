// Adapted from Slate examples/algebra/inverse_uniqueness.slate.
// Changed for this fixture: renamed the module and selected ambient theory.
// SPDX-License-Identifier: Apache-2.0
module Pebble.Fixtures.Algebra.Inverses
    under Pebble.Fixtures.Algebra.Group

    theorem LeftInverseUnique(a : Element, b : Element): b * a = one -> b = inverse(a)
        (left_inverse_of_a : b * a = one) =>
            b = b * one from right_identity(b)
            b * one = b * (a * inverse(a)) from right_inverse(a)
            b * (a * inverse(a)) = (b * a) * inverse(a) from associative(b, a, inverse(a))
            (b * a) * inverse(a) = one * inverse(a) from left_inverse_of_a
            one * inverse(a) = inverse(a) from left_identity(inverse(a))

    theorem RightInverseUnique(a : Element, b : Element): a * b = one -> b = inverse(a)
        (right_inverse_of_a : a * b = one) =>
            b = one * b from left_identity(b)
            one * b = (inverse(a) * a) * b from left_inverse(a)
            (inverse(a) * a) * b = inverse(a) * (a * b) from associative(inverse(a), a, b)
            inverse(a) * (a * b) = inverse(a) * one from right_inverse_of_a
            inverse(a) * one = inverse(a) from right_identity(inverse(a))

    theorem LeftInverseIsRightInverse(a : Element, b : Element): b * a = one -> a * b = one
        (left_inverse_of_a : b * a = one) =>
            canonical_inverse : b = inverse(a) from LeftInverseUnique(a, b), left_inverse_of_a
            a * b = a * inverse(a) from canonical_inverse
            a * inverse(a) = one from right_inverse(a)
