# Copy to production.compose.env, then replace every placeholder.
PEBBLE_IMAGE=REPLACE_WITH_APPROVED_REGISTRY_IMAGE_AT_SHA256_DIGEST
SLATE_TOOLCHAIN_DIR=/opt/pebble/toolchains/current
PEBBLE_DOMAIN=REPLACE_WITH_OWN_DOMAIN
ACME_EMAIL=REPLACE_WITH_OPERATIONS_EMAIL
# Dedicated ingress bridge. Change all three together if this subnet conflicts
# with the host/VPC; API trusts only this Caddy address, not arbitrary XFF.
PEBBLE_PRIVATE_SUBNET=172.30.0.0/24
PEBBLE_EDGE_IP=172.30.0.2
PEBBLE_API_IP=172.30.0.3
