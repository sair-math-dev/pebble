# Store the filled file as production.api.env with mode 0600; never commit it.
REGISTRY_ID=REPLACE_WITH_ONE_FIXED_UUID
# PEBBLE_TOOLCHAIN_TAG and the PEBBLE_INDEX_ROOT / PEBBLE_DL_TEMPLATE /
# PEBBLE_API_ROOT roots come from the Compose environment (hosts + tag).
DATABASE_URL=postgresql://pebble_api:REPLACE@db.internal:5432/pebble?sslmode=verify-full
DB_POOL_SIZE=12
# Single-host production Compose sets TRUST_PROXY_CIDRS to its fixed edge /32.
# With a managed load balancer, set only the actual controlled proxy CIDRs and
# restrict the API ingress to that balancer. Never trust arbitrary forwarded IPs.
S3_REGION=us-east-1
S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
S3_FORCE_PATH_STYLE=false
# Native AWS S3 uses no S3_ENDPOINT override. A compatible provider must be tested.
# Prefer a workload identity. If unavailable, inject these from a secret manager:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# For private CA roots: NODE_EXTRA_CA_CERTS=/run/secrets/database-ca.pem
