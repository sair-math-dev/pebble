[Unit]
Description=Pebble isolated Slate verification worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=pebble-worker
Group=pebble-worker
WorkingDirectory=/opt/pebble/current
Environment=NODE_ENV=production
Environment=TMPDIR=/var/lib/pebble-worker
Environment=SLATE_ROOTFS=/opt/pebble/toolchains/current
EnvironmentFile=/etc/pebble/worker.env
ExecStartPre=/usr/bin/node /opt/pebble/current/deployment/worker-preflight.mjs
ExecStart=/usr/bin/node /opt/pebble/current/dist/main.js worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
UMask=0077
StateDirectory=pebble-worker
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Bubblewrap requires fresh namespaces. Do not use RestrictNamespaces=yes,
# PrivateUsers=yes, or a generic syscall filter which blocks its namespace setup.
MemoryMax=4G
MemorySwapMax=0
CPUQuota=200%
TasksMax=128
LimitNOFILE=4096
LimitFSIZE=536870912

[Install]
WantedBy=multi-user.target
