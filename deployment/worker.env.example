# Install as /etc/pebble/worker.env, owner root, mode 0600.
REGISTRY_ID=REPLACE_WITH_THE_SAME_FIXED_UUID
PEBBLE_TOOLCHAIN_TAG=REPLACE_WITH_THE_SAME_TOOLCHAIN_TAG
DATABASE_URL=postgresql://pebble_worker:REPLACE@db.internal:5432/pebble?sslmode=verify-full
DB_POOL_SIZE=4
S3_REGION=us-east-1
S3_BUCKET=REPLACE_WITH_THE_SAME_PRIVATE_BUCKET
S3_FORCE_PATH_STYLE=false
# The coordinator reads credentials; the Slate subprocess receives a clean env
# inside bubblewrap and never sees this file, the host filesystem, DB, or S3.
